{
  "name": "ai-title-siyuan",
  "version": "1.4.0",
  "description": "Generate note titles with the Chat Completions, Responses, Anthropic Messages or Gemini Interactions API",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && node scripts/build-package.mjs",
    "icon": "node scripts/render-icon.mjs && node scripts/render-preview.mjs",
    "preview": "node scripts/render-preview.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "siyuan",
    "plugin",
    "ai",
    "title",
    "openai"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.11",
    "archiver": "^8.0.0",
    "playwright": "^1.65.1",
    "sass-embedded": "^1.108.2",
    "sharp": "^0.35.5",
    "siyuan": "^1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
